<UserControl x:Class="UavMissionControl.App.Views.MissionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="60" d:DesignWidth="600">
    <GroupBox Header="Mission Control">
        <StackPanel Orientation="Horizontal" Margin="8">
            <TextBlock Text="State:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock x:Name="MissionStateText" Text="{Binding MissionState}" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,16,0" Width="110"/>
            <TextBlock Text="Elapsed:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock x:Name="ElapsedText" Text="{Binding ElapsedDisplay}"
                       VerticalAlignment="Center" Margin="0,0,16,0" Width="60"/>
            <Button x:Name="StartButton" Content="Start" Command="{Binding StartCommand}" Width="80" Margin="0,0,4,0"/>
            <Button x:Name="PauseButton" Content="Pause" Command="{Binding PauseCommand}" Width="80" Margin="0,0,4,0"/>
            <Button x:Name="ResumeButton" Content="Resume" Command="{Binding ResumeCommand}" Width="80" Margin="0,0,4,0"/>
            <Button x:Name="StopButton" Content="Stop" Command="{Binding StopCommand}" Width="80"/>
        </StackPanel>
    </GroupBox>
</UserControl>
