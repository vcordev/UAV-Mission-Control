<UserControl x:Class="UavMissionControl.App.Views.ConnectionPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="60" d:DesignWidth="500">
    <GroupBox Header="Connection">
        <StackPanel Orientation="Horizontal" Margin="8">
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,16,0" Width="90"/>
            <Button x:Name="ConnectButton" Content="Connect" Command="{Binding ConnectCommand}"
                    Width="90" Margin="0,0,8,0"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Command="{Binding DisconnectCommand}"
                    Width="90"/>
        </StackPanel>
    </GroupBox>
</UserControl>
