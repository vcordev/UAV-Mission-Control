<UserControl x:Class="UavMissionControl.App.Views.TelemetryDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="100" d:DesignWidth="600">
    <GroupBox Header="Telemetry">
        <UniformGrid Rows="2" Columns="3" Margin="8">
            <StackPanel Margin="4">
                <TextBlock Text="Battery"/>
                <TextBlock x:Name="BatteryText" Text="{Binding BatteryPercent, StringFormat={}{0:0.0}%}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="4">
                <TextBlock Text="Signal"/>
                <TextBlock x:Name="SignalText" Text="{Binding SignalStrengthPercent, StringFormat={}{0:0.0}%}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="4">
                <TextBlock Text="Latitude"/>
                <TextBlock x:Name="LatitudeText" Text="{Binding Latitude, StringFormat={}{0:0.00000}}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="4">
                <TextBlock Text="Longitude"/>
                <TextBlock x:Name="LongitudeText" Text="{Binding Longitude, StringFormat={}{0:0.00000}}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="4">
                <TextBlock Text="Altitude"/>
                <TextBlock x:Name="AltitudeText" Text="{Binding AltitudeMeters, StringFormat={}{0:0.0} m}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Margin="4">
                <TextBlock Text="Speed"/>
                <TextBlock x:Name="SpeedText" Text="{Binding SpeedMetersPerSecond, StringFormat={}{0:0.0} m/s}" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
        </UniformGrid>
    </GroupBox>
</UserControl>
